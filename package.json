{
  "name": "mpd-dashboard",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node --env-file=.env --import tsx server/index.ts\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "electron-builder",
    "desktop:release": "electron-builder --publish always"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.6",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^7.1.0",
    "@fullcalendar/timegrid": "^6.1.21",
    "@radix-ui/react-slot": "^1.2.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "googleapis": "^182.0.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "next-themes": "^0.4.6",
    "puppeteer": "^25.12.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.3",
    "sonner": "^2.0.8",
    "spin-wheel": "^5.0.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.0",
    "xlsx": "^0.18.5",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.metropd.desktop",
    "productName": "Metro Police Department",
    "artifactName": "MPD-Police-Department-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.png",
      "desktop/icon.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metro Police Department",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "EagleModifications",
      "repo": "MPDWebsite-Render",
      "releaseType": "release"
    }
  },
  "description": "Metro Police Department desktop application",
  "author": "Metro Police Department"
}
